EUROPEANA_API_KEY=
GEMINI_API_KEY=
BING_IMAGE_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
FLICKR_API_KEY=
GEMINI_MODEL=

# Publicación social (fase 1). Crea las aplicaciones oficiales de Meta y TikTok,
# obtén tokens de acceso y guárdalos solo en tu .env privado.
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# Visión local mediante Ollama. El valor predeterminado usa Qwen2.5-VL 7B.
VISION_BACKEND=local
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_VISION_MODEL=qwen2.5vl:7b
LOCAL_VISION_TIMEOUT=180
